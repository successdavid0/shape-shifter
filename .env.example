# SHAPESHIFTERS — environment template. Copy to .env.local and fill.
# .env.local is gitignored. NEVER commit real keys or a WalletConnect id.

# Wallet / chain (used at the web3 swap point — see src/lib/hooks/useMintState.ts)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract (mirror into src/lib/content.ts collection.contractAddress when known)
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_EXPLORER_BASE=

# Whitelist / allowlist capture (optional — see src/components/web3/WhitelistForm.tsx)
# When set, reserved wallet addresses are POSTed here as { "address": "0x…" }.
# Leave blank to record reservations in the visitor's browser only (localStorage).
NEXT_PUBLIC_WHITELIST_ENDPOINT=

# Site
NEXT_PUBLIC_SITE_URL=https://shapeshifters.example
