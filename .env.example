# SHAPESHIFTERS — environment template. Copy to .env.local and fill.
# .env.local is gitignored. NEVER commit real keys or a WalletConnect id.

# Wallet / chain (used at the web3 swap point — see src/lib/hooks/useMintState.ts)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract (mirror into src/lib/content.ts collection.contractAddress when known)
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_EXPLORER_BASE=

# Whitelist / allowlist capture (see src/components/web3/WhitelistForm.tsx)
# Reserved wallet addresses are POSTed here as { "address": "0x…" }.
# Defaults to the built-in /api/whitelist route (Supabase-backed, below).
# Override only to point at a different form service / backend.
NEXT_PUBLIC_WHITELIST_ENDPOINT=/api/whitelist

# Supabase — backs the /api/whitelist route (see supabase/schema.sql).
# Server-only: the service_role key must NEVER be exposed as NEXT_PUBLIC_.
# Leave blank to keep reservations in the visitor's browser only (localStorage);
# the route then returns 503 and the form falls back gracefully.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin — password for /admin/whitelist (server-only, never NEXT_PUBLIC_).
# Used to view reservations in-app. Pick a long random string.
ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=https://shapeshifters.example
